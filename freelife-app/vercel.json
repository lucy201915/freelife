{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(dashboard|chat|chats|message|messages|inbox|contract|contracts|agreement|agreements|payment|payments|checkout|billing|order|orders|account|settings|auth|login|signup|me)(/.*)?",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
